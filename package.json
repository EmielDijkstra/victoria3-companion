{
	"name": "victoria3-companion",
	"version": "0.0.1",
	"private": true,
	"description": "Lokale overlay-adviseur voor Victoria 3",
	"type": "module",
	"main": "dist-electron/main.cjs",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "concurrently -k -n web,app -c blue,yellow \"vite dev --port 5180 --strictPort\" \"wait-on tcp:localhost:5180 && npm run build:electron && electron . --dev-server=http://localhost:5180\"",
		"start": "electron .",
		"build": "npm run build:web && npm run build:electron",
		"build:electron": "esbuild electron/main.ts electron/preload.ts electron/save-reader-worker.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist-electron --out-extension:.js=.cjs --log-level=warning",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p electron/tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest --run && playwright test",
		"build:web": "vite build",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24.19.2",
		"concurrently": "^10.0.7",
		"electron": "^45.3.3",
		"esbuild": "^0.28.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"wait-on": "^9.5.1"
	},
	"dependencies": {
		"@fontsource/eb-garamond": "^5.3.0"
	}
}
