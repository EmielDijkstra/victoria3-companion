# Alleen nodig voor "Vraag door" (de AI-adviseur). Zet je eigen sleutel in .env, nooit in de repo.
# De app stuurt alleen iets naar Gemini als je zelf een vraag stelt; nooit vanzelf.
# Gratis: Google AI Studio (aistudio.google.com) -> Get API key
GEMINI_API_KEY=
# Optioneel: ander Gemini-model (standaard gemini-3.6-flash)
GEMINI_MODEL=
# Optioneel
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
